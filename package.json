{
  "name": "personal-growth-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:preview": "wrangler dev --env preview",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy",
    "test": "node --test",
    "test:integration": "node --test tests/integration/worker-d1.integration.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser/browser-e2e.browser.js tests/browser/functional-recovery.browser.js tests/browser/breathing-visual.browser.js",
    "db:migrate:local": "wrangler d1 migrations apply personal-growth-tracker --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "playwright": "1.62.0",
    "wrangler": "4.123.0"
  }
}
