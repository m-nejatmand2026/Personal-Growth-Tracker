{
  "name": "personal-growth-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:preview": "wrangler dev --env preview",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "test": "node --test",
    "db:create": "wrangler d1 create personal-growth-tracker",
    "db:migrate:local": "wrangler d1 migrations apply personal-growth-tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply personal-growth-tracker --remote",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  }
}
