{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-growth-tracker",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-growth-tracker",
      "database_id": "a182d8c8-c009-461e-ac7e-04694c1047ab",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "personal-growth-tracker-preview",
          "database_id": "1937971c-f2f2-4dad-bc65-3d22952584bb",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
